# Notification Configuration (Optional - for Phase 1.2)
# Telegram Bot Token (create via @BotFather on Telegram)
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Discord Webhook URL (create in Discord Server Settings > Integrations > Webhooks)
# DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# SendGrid API Key (for email notifications)
# SENDGRID_API_KEY=your_sendgrid_api_key_here
# NOTIFICATION_EMAIL_FROM=bot@yourdomain.com
