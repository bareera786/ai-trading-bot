[Unit]
Description=AI Trading Bot Flask Application
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=aibot
WorkingDirectory=/home/aibot/ai-bot
Environment="PATH=/home/aibot/ai-bot/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="FLASK_APP=run.py"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/home/aibot/ai-bot/.env
ExecStart=/home/aibot/ai-bot/.venv/bin/python3 /home/aibot/ai-bot/run.py
Restart=always
RestartSec=10
StandardOutput=append:/home/aibot/ai-bot/bot_stdout.log
StandardError=append:/home/aibot/ai-bot/bot_stdout.log

[Install]
WantedBy=multi-user.target
